<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Required so IDE0005 (unnecessary usings) is enforced on build; CS1591 (missing XML doc) is noise here. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.66" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <PackageReference Include="Polly" Version="8.6.4" />
    <PackageReference Include="Serilog" Version="4.3.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="SharpCompress" Version="0.41.0" />
  </ItemGroup>

  <!--
    SharpCompress 0.41.0 is the version proven in v1 and pinned by the Phase 0 brief, but it
    carries a moderate advisory (GHSA-6c8g-7p36-r338) published after v1's last build. It is
    unused in Phase 0 (archive extraction lands in a later phase). Suppress this single advisory
    so the zero-warning gate holds; auditing stays active for every other package/advisory.
    Revisit and upgrade before archive extraction actually consumes SharpCompress.
  -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-6c8g-7p36-r338" />
  </ItemGroup>

</Project>
