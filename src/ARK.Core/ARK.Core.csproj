<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Required so IDE0005 (unnecessary usings) is enforced on build; CS1591 (missing XML doc) is noise here. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.66" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <PackageReference Include="Polly" Version="8.6.4" />
    <PackageReference Include="Serilog" Version="4.3.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="SharpCompress" Version="0.41.0" />
  </ItemGroup>

  <!--
    SharpCompress 0.41.0 carries GHSA-6c8g-7p36-r338 / CVE-2026-44788: an unpatched zip-slip
    path traversal in IArchive.WriteToDirectory(). Every release through 0.47.4 is affected, so
    there is no version bump to take. The mitigation is to never call that method (enforced by
    ArchitectureTests.SharpCompress_WriteToDirectory_is_never_referenced) — ARK only reads entry
    lists and streams single entries for hashing. Suppress this one advisory so the zero-warning
    gate holds; auditing stays active for every other package/advisory.
  -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-6c8g-7p36-r338" />
  </ItemGroup>

</Project>
